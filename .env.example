# GitHub Packages publish credentials (needed for sbt publish).
# Copy this file to .env and fill in your values. .env is gitignored.
#
# Create a Personal Access Token (PAT) at:
#   GitHub → Settings → Developer settings → Personal access tokens
# With scope: write:packages (and read:packages if you want to resolve from GitHub Packages).
#
GITHUB_PACKAGES_USER=THK-ADV
GITHUB_PACKAGES_TOKEN=your_personal_access_token_here
